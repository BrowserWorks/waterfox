{
  "background": {
    "color": {
      "inactive": {
        "value": {
          "nativeTheme": "-moz-headerbarinactive",
          "default": "transparent"
        }
      },
      "gradient-leading": {
        "value": {
          "light": "#e7f3ff",
          "dark": "#0d2640",
          "forcedColors": "Canvas"
        }
      },
      "gradient-trailing": {
        "value": {
          "light": "{color.violet.30}",
          "dark": "#081a2d",
          "forcedColors": "Canvas"
        }
      }
    }
  },
  "text": {
    "color": {
      "@base": {
        "value": {
          "nativeTheme": "-moz-headerbartext",
          "default": "{text.color.@base}"
        }
      },
      "inactive": {
        "value": {
          "nativeTheme": "-moz-headerbarinactivetext",
          "default": "{text.color.deemphasized}"
        }
      }
    }
  }
}
