# These dumps replace the Mozilla search configuration. The collections stay
# offline under the Waterfox Remote Settings policy, so whatever ships here is
# the entire search configuration. Bump the dump timestamp and changed records'
# last_modified values whenever the configuration changes.
FINAL_TARGET_FILES.defaults.settings.main += [
    "dumps/main/search-config-icons.json",
    "dumps/main/search-config-overrides-v2.json",
    "dumps/main/search-config-v2.json",
]

FINAL_TARGET_FILES.defaults.settings.main["search-config-icons"] += [
