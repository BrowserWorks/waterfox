browser.jar:
%   content browser %content/browser/ contentaccessible=yes
    content/browser/waterfox/settings/WaterfoxSettingsPanes.mjs          (WaterfoxSettingsPanes.mjs)
    content/browser/waterfox/settings/waterfoxAdBlocking.mjs             (waterfoxAdBlocking.mjs)
    content/browser/waterfox/settings/waterfoxAppearance.mjs             (waterfoxAppearance.mjs)
    content/browser/waterfox/settings/waterfoxAppearance.css             (waterfoxAppearance.css)
    content/browser/waterfox/settings/waterfoxAppearanceOptions.mjs      (waterfoxAppearanceOptions.mjs)
    content/browser/waterfox/settings/previews/                          (previews/*.svg)
    content/browser/waterfox/settings/waterfoxDataCollection.mjs         (waterfoxDataCollection.mjs)
    content/browser/waterfox/settings/waterfoxDns.mjs                    (waterfoxDns.mjs)
    content/browser/waterfox/settings/waterfoxHome.mjs                   (waterfoxHome.mjs)
    content/browser/waterfox/settings/waterfoxPrivacy.mjs                (waterfoxPrivacy.mjs)
    content/browser/waterfox/settings/waterfoxSearch.mjs                 (waterfoxSearch.mjs)
    content/browser/waterfox/settings/waterfoxTabs.mjs                   (waterfoxTabs.mjs)
    content/browser/waterfox/settings/waterfoxUpdates.mjs                (waterfoxUpdates.mjs)
