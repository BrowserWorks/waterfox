Source: waterfox
Maintainer: BrowserWorks <MrAlex94@users.noreply.github.com>
Priority: optional
Section: web
Standards-Version: 4.6.2
# The runtime libraries Waterfox links must be present in the build root so
# dh_shlibdeps can resolve them into the package's Depends. The t64 renamed
# packages are listed as alternatives so this works on both old and new distros.
Build-Depends: debhelper (>= 9),
 libgtk-3-0 | libgtk-3-0t64,
 libglib2.0-0 | libglib2.0-0t64,
 libatk1.0-0 | libatk1.0-0t64,
 libasound2 | libasound2t64,
 libdbus-1-3,
 libpango-1.0-0,
 libcairo2,
 libcairo-gobject2,
 libgdk-pixbuf-2.0-0,
 libfreetype6,
 libfontconfig1,
 libx11-6,
 libx11-xcb1,
 libxcb1,
 libxcb-shm0,
 libxext6,
 libxrandr2,
 libxcomposite1,
 libxcursor1,
 libxdamage1,
 libxfixes3,
 libxi6,
 libxrender1
Homepage: https://www.waterfox.net/

Package: waterfox
Architecture: any
Depends: ${shlibs:Depends}, ${misc:Depends}
Provides: gnome-www-browser, www-browser
Description: Waterfox, a privacy conscious web browser
 Waterfox is a customizable, privacy conscious web browser based on Firefox.
 It keeps the features people rely on while putting control and privacy first.
