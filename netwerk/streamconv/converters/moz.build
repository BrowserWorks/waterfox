XPIDL_SOURCES += ["nsICompressConvStats.idl"]

EXPORTS += [
    "nsHTTPCompressConv.h",
    "nsUnknownDecoder.h",
]

XPIDL_MODULE = "necko_http"

UNIFIED_SOURCES += [
    "mozTXTToHTMLConv.cpp",
    "nsDirIndex.cpp",
    "nsDirIndexParser.cpp",
    "nsHTTPCompressConv.cpp",
    "nsIndexedToHTML.cpp",
    "nsMultiMixedConv.cpp",
    "nsUnknownDecoder.cpp",
]

FINAL_LIBRARY = "xul"

LOCAL_INCLUDES += [
    "/netwerk/base",
]

DIRS += [
    "/third_party/zstd",
]
