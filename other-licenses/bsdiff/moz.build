HOST_SOURCES += [
    'bsdiff.c',
]

HostProgram('mbsdiff')

if (
    CONFIG['OS_ARCH'] == 'Darwin'
    and CONFIG['MOZ_BUILD_APP'] != 'tools/update-packaging'
):
    Program('mbsdiff-target')
    SOURCES += ['bsdiff.c']

if CONFIG['HOST_OS_ARCH'] == 'WINNT':
    HOST_OS_LIBS += [
        'ws2_32',
    ]
    USE_STATIC_MSVCRT = True

LOCAL_INCLUDES += [
    '/toolkit/mozapps/update/updater',
    '/toolkit/mozapps/update/updater/bspatch',
]
