features = []
if CONFIG["MOZ_MEMORY"]:
    features += ["moz_memory"]

RustLibrary("moz_zlib", features)

OS_LIBS += CONFIG["DL_LIBS"]

if CONFIG["OS_ARCH"] == "Darwin":
    OS_LIBS += ["-lresolv"]
elif CONFIG["OS_ARCH"] == "WINNT":
    OS_LIBS += [
        "advapi32",
        "bcrypt",
        "ntdll",
        "synchronization",
        "userenv",
        "ws2_32",
    ]
