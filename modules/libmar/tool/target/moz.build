Program("mar-target")

SOURCES += [
    "/modules/libmar/tool/mar.c",
    "/other-licenses/nsis/Contrib/CityHash/cityhash/city.cpp",
]

USE_LIBS += ["mar"]

DEFINES["NO_SIGN_VERIFY"] = True

for var in ("MAR_CHANNEL_ID", "MOZ_APP_VERSION"):
    DEFINES[var] = '"%s"' % CONFIG[var]

DisableStlWrapping()
